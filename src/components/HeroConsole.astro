---
// Hero Console Component (Subdued, Eye-Friendly OLED Brutalism)
---

<section class="w-full border border-[#141418] bg-[#050507]/90 backdrop-blur-sm p-6 lg:p-10 relative overflow-hidden" data-purpose="hero-console" id="hero">
  <!-- Corner diagnostic identifier -->
  <div class="absolute top-2.5 right-4 text-[10px] text-zinc-600 tracking-wider select-none font-mono">
    NODE::EDGE_CF <span class="text-[#e11d48] font-bold ml-1.5">@ThunderRonin</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center font-mono">
    <!-- Left Column: Primary Identity -->
    <div class="lg:col-span-7 space-y-5">
      <div class="space-y-2">
        <div class="flex items-center space-x-2">
          <span class="text-[#e11d48] font-bold text-2xl lg:text-3xl">&gt;</span>
          <h1 class="text-3xl lg:text-5xl font-bold tracking-tight text-zinc-100 flex items-center">
            amirali_daliri<span class="inline-block w-2.5 lg:w-3 h-6 lg:h-8 ml-2 bg-[#e11d48] animate-cursor"></span>
          </h1>
        </div>
        <div class="flex items-center gap-2 pt-1 text-xs">
          <span class="text-zinc-400 font-medium">Full-Stack Software Engineer</span>
          <span class="text-zinc-700">|</span>
          <span class="text-zinc-500">Systems &amp; AI Architect</span>
          <span class="bg-[#18181b] text-zinc-400 border border-[#27272a] px-2 py-0.5 text-[10px]">
            github.com/ThunderRonin
          </span>
        </div>
      </div>

      <p class="text-xs lg:text-sm text-zinc-400 max-w-xl leading-relaxed font-light">
        Architecting high-concurrency enterprise backends in <span class="text-zinc-200 font-medium">.NET 10 (C# 14)</span>, cross-platform client ecosystems in <span class="text-zinc-200 font-medium">Flutter</span>, semantic AI orchestration pipelines, and Cloudflare edge runtimes.
      </p>

      <!-- Soft, Eye-Friendly Telemetry Tags -->
      <div class="flex flex-wrap gap-2 text-[10px]">
        <div class="border border-[#18181b] bg-[#08080a] px-2.5 py-1 text-zinc-300 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 bg-emerald-500/80"></span>
          <span>SYSTEMS::PRODUCTION</span>
        </div>
        <div class="border border-[#18181b] bg-[#08080a] px-2.5 py-1 text-zinc-400">
          CORE::DOTNET10_CSHARP14
        </div>
        <div class="border border-[#18181b] bg-[#08080a] px-2.5 py-1 text-zinc-400">
          MOBILE::FLUTTER_DART
        </div>
        <div class="border border-[#18181b] bg-[#08080a] px-2.5 py-1 text-zinc-400">
          INFRA::DOCKER_SWARM_LINUX
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2 text-xs">
        <a
          href="#projects"
          class="px-4 py-2 bg-[#18181b] hover:bg-[#27272a] text-zinc-200 border border-[#27272a] transition-all flex items-center gap-1.5 font-medium"
        >
          <span class="text-[#e11d48]">&gt;</span> EXPLORE_SYSTEMS
        </a>
        <a
          href="/resume.pdf"
          target="_blank"
          download="amirali_daliri_resume.pdf"
          class="px-3.5 py-2 bg-[#0d0d12] hover:bg-[#18181b] text-zinc-300 hover:text-white border border-[#27272a] transition-all flex items-center gap-1.5 font-medium"
        >
          <span class="text-[#e11d48]">↓</span> RESUME_PDF
        </a>
        <a
          href="https://github.com/ThunderRonin"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-2 border border-[#18181b] hover:border-zinc-700 bg-[#08080a] text-zinc-400 hover:text-zinc-200 transition-all flex items-center gap-1.5 font-medium"
        >
          <span>&lt;&gt;</span> GITHUB
        </a>
        <a
          href="#cli"
          class="px-3 py-2 border border-[#18181b] text-zinc-500 hover:text-zinc-300 transition-all text-xs"
        >
          CLI_SHELL
        </a>
      </div>
    </div>

    <!-- Right Column: Architecture Blueprint Card -->
    <div class="lg:col-span-5 border border-[#141418] bg-[#030304] p-5 space-y-4 text-xs font-mono">
      <div class="flex items-center justify-between border-b border-[#141418] pb-2 text-[10px]">
        <span class="text-zinc-500 tracking-wider uppercase font-bold">SYSTEMS_TOPOLOGY</span>
        <span class="text-zinc-500 font-mono">CORE_STACK</span>
      </div>

      <div class="space-y-2 text-[11px]">
        <div class="flex justify-between items-center text-zinc-400">
          <span>ENTERPRISE_CORE:</span>
          <span class="text-zinc-200">.NET 10 / C# 14 + EF Core</span>
        </div>
        <div class="flex justify-between items-center text-zinc-400">
          <span>MOBILE_CLIENTS:</span>
          <span class="text-zinc-200">Flutter / Dart (Cross-Platform)</span>
        </div>
        <div class="flex justify-between items-center text-zinc-400">
          <span>AI_ORCHESTRATION:</span>
          <span class="text-zinc-200">Bun + Elysia + LanceDB RAG</span>
        </div>
        <div class="flex justify-between items-center text-zinc-400">
          <span>INFRASTRUCTURE:</span>
          <span class="text-zinc-200">Docker Swarm + Caddy + Linux</span>
        </div>
        <div class="flex justify-between items-center text-zinc-400">
          <span>EDGE_PROXY:</span>
          <span class="text-zinc-200">Cloudflare Workers Edge</span>
        </div>
      </div>

      <div class="pt-3 border-t border-[#141418] space-y-1.5">
        <div class="text-[10px] text-zinc-600 uppercase tracking-wider">PRIMARY_TOOLCHAIN:</div>
        <div class="flex flex-wrap gap-1 text-[10px]">
          <span class="px-1.5 py-0.5 bg-[#08080a] border border-[#18181b] text-zinc-300 font-medium">.NET 10</span>
          <span class="px-1.5 py-0.5 bg-[#08080a] border border-[#18181b] text-zinc-300 font-medium">C# 14</span>
          <span class="px-1.5 py-0.5 bg-[#08080a] border border-[#18181b] text-zinc-300 font-medium">Flutter</span>
          <span class="px-1.5 py-0.5 bg-[#08080a] border border-[#18181b] text-zinc-400">Dart</span>
          <span class="px-1.5 py-0.5 bg-[#08080a] border border-[#18181b] text-zinc-400">EF Core</span>
          <span class="px-1.5 py-0.5 bg-[#08080a] border border-[#18181b] text-zinc-400">TypeScript</span>
          <span class="px-1.5 py-0.5 bg-[#08080a] border border-[#18181b] text-zinc-400">Docker Swarm</span>
          <span class="px-1.5 py-0.5 bg-[#08080a] border border-[#18181b] text-zinc-400">PostgreSQL</span>
          <span class="px-1.5 py-0.5 bg-[#08080a] border border-[#18181b] text-zinc-400">CF Workers</span>
        </div>
      </div>
    </div>
  </div>
</section>
