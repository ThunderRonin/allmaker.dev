---
// Column 3: Communication Endpoints & Edge Gateway
---

<div class="space-y-3 font-mono" id="connect">
  <div class="flex items-center justify-between border-b border-[#141418] pb-2">
    <div class="flex items-center space-x-2">
      <span class="text-[#e11d48] font-bold">&gt;</span>
      <h2 class="text-xs md:text-sm font-bold text-zinc-100 uppercase tracking-wider">./connect --direct</h2>
    </div>
    <span class="text-[10px] text-zinc-600">[04] DISPATCH</span>
  </div>

  <div class="border border-[#141418] bg-[#050507] p-5 h-[calc(100%-2.2rem)] flex flex-col justify-between space-y-4 font-mono text-xs">
    <div class="space-y-2">
      <!-- GitHub -->
      <a
        class="flex items-center justify-between p-2.5 bg-[#020203] border border-[#141418] hover:border-zinc-700 group transition-all"
        href="https://github.com/ThunderRonin"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="text-zinc-500 flex items-center gap-2">
          <span class="text-[#e11d48]">&lt;&gt;</span> github:
        </span>
        <span class="text-zinc-300 group-hover:text-white transition-colors">github.com/ThunderRonin</span>
      </a>

      <!-- Email -->
      <a
        class="flex items-center justify-between p-2.5 bg-[#020203] border border-[#141418] hover:border-zinc-700 group transition-all"
        href="mailto:amirali@allmaker.dev"
      >
        <span class="text-zinc-500 flex items-center gap-2">
          <span class="text-[#e11d48]">@</span> email:
        </span>
        <span class="text-zinc-300 group-hover:text-white transition-colors">amirali@allmaker.dev</span>
      </a>

      <!-- Cloudflare Edge Verification -->
      <div class="p-2.5 bg-[#020203] border border-[#141418] flex items-center justify-between text-[11px]">
        <span class="text-zinc-500 flex items-center gap-2">
          <span class="text-emerald-500/80">⚡</span> edge:
        </span>
        <span class="text-zinc-400">Cloudflare Workers</span>
      </div>
    </div>

    <!-- Resume Download CTA -->
    <div class="pt-2 border-t border-[#141418]">
      <a
        class="flex items-center justify-between px-3 py-2 bg-[#0a0a0e] border border-[#1e1e24] hover:border-zinc-600 text-zinc-300 hover:text-white transition-all text-xs font-medium group"
        href="/resume.pdf"
        target="_blank"
        download="amirali_daliri_resume.pdf"
      >
        <span class="flex items-center gap-2 text-zinc-400">
          <span class="text-[#e11d48]">📄</span> dossier:
        </span>
        <span class="bg-[#18181b] border border-[#27272a] text-zinc-300 group-hover:text-white px-2 py-0.5 text-[10px] tracking-wider uppercase font-semibold flex items-center gap-1">
          DOWNLOAD_RESUME <span class="text-[9px]">↓</span>
        </span>
      </a>
    </div>
  </div>
</div>
