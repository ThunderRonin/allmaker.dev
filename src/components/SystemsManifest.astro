---

<section class="space-y-4 font-mono" data-purpose="systems-manifest" id="projects">
  <!-- Section Header Strip -->
  <div class="flex items-center justify-between border-b border-[#141418] pb-2 text-xs">
    <div class="flex items-center space-x-2">
      <span class="text-[#e11d48] font-bold">&gt;</span>
      <h2 class="text-sm font-bold text-zinc-100 tracking-wide uppercase">systemctl list-units --all // PROJECTS &amp; EXPERIENCES</h2>
    </div>
    <div class="text-[10px] text-zinc-500 tracking-wider">
      [01] WORKLOAD MANIFEST // ACTIVE SYSTEMS &amp; FIELD EXPERIENCES
    </div>
  </div>

  <!-- Responsive Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
    {projects.map((project) => (
      <article
        class="border border-[#141418] bg-[#050507] p-4 flex flex-col justify-between hover:border-zinc-800 transition-all group relative hover:bg-[#08080b]"
      >
        <!-- Top Status Bar -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between border-b border-[#141418] pb-1.5 text-[11px]">
            <div class="flex items-center space-x-1.5">
              <span class="text-[#e11d48] font-bold text-xs">{project.id}</span>
              <h3 class="text-sm font-bold text-zinc-100 group-hover:text-white transition-colors">
                {project.name}
              </h3>
            </div>
            {project.stars !== undefined && project.stars > 0 && (
              <span class="text-[10px] text-zinc-500 flex items-center gap-0.5">
                ★ {project.stars}
              </span>
            )}
          </div>

          <div class="flex items-center justify-between text-[9px]">
            <span class="text-zinc-500 tracking-wider font-semibold uppercase">{project.category}</span>
            <span class="px-1 py-0.2 border border-[#27272a] bg-[#0c0c10] text-zinc-400 font-mono">
              {project.badge}
            </span>
          </div>

          <p class="text-[11px] text-zinc-400 leading-relaxed font-light">
            {project.description}
          </p>
        </div>

        <!-- Middle Telemetry Metrics -->
        <div class="my-3 py-2 px-2.5 bg-[#000000] border border-[#141418] space-y-1 text-[10px]">
          {project.metrics.map((m) => (
            <div class="flex items-center justify-between">
              <span class="text-zinc-500">{m.label}:</span>
              <span class="text-zinc-300 font-medium">{m.value}</span>
            </div>
          ))}
        </div>

        <!-- Bottom Stack Tags & Link -->
        <div class="space-y-2.5 pt-2 border-t border-[#141418]">
          <div class="flex flex-wrap gap-1 text-[9px]">
            {project.tech.map((t) => (
              <span class="px-1.5 py-0.5 bg-[#08080a] border border-[#18181b] text-zinc-400">
                {t}
              </span>
            ))}
          </div>

          {project.githubUrl && (
            <div class="flex items-center justify-between text-[10px] pt-1">
              <span class="text-zinc-600">&gt; source:</span>
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-zinc-400 hover:text-white hover:underline transition-colors flex items-center gap-1"
              >
                VIEW_ON_GITHUB <span class="text-[9px]">↗</span>
              </a>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
