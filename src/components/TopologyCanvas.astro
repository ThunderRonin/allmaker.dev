---
// 3D Background Component: Topological Network Constellation & Geometric Lattice
// Calibrated for OLED Pure Black (#000000) with Eye-Friendly Muted Luminescence
---

<div class="fixed inset-0 w-full h-full pointer-events-none z-0 bg-[#000000] overflow-hidden" aria-hidden="true">
  <div id="threejs-topology-container" class="w-full h-full"></div>
</div>

<script>
  import * as THREE from 'three';

  function initTopology() {
    const container = document.getElementById('threejs-topology-container');
    if (!container) return;

    while (container.firstChild) {
      container.removeChild(container.firstChild);
    }

    const getWidth = () => container.clientWidth || window.innerWidth || 1440;
    const getHeight = () => container.clientHeight || window.innerHeight || 900;

    let width = getWidth();
    let height = getHeight();

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 1000);
    camera.position.set(0, 0, 160);

    const renderer = new THREE.WebGLRenderer({
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setClearColor(0x000000, 1);
    container.appendChild(renderer.domElement);

    const rootGroup = new THREE.Group();
    scene.add(rootGroup);

    // 1. Subtle Background Wireframe Polyhedron (The Architectural Monolith)
    // Low-opacity, calm, mathematical wireframe core
    const monolithGeo = new THREE.OctahedronGeometry(36, 2);
    const monolithWire = new THREE.WireframeGeometry(monolithGeo);
    const monolithMat = new THREE.LineBasicMaterial({
      color: 0x222226, // Ultra-faint slate-zinc
      transparent: true,
      opacity: 0.35,
    });
    const monolith = new THREE.LineSegments(monolithWire, monolithMat);
    rootGroup.add(monolith);

    // Inner subtle counter-rotating core
    const innerCoreGeo = new THREE.IcosahedronGeometry(18, 1);
    const innerWire = new THREE.WireframeGeometry(innerCoreGeo);
    const innerMat = new THREE.LineBasicMaterial({
      color: 0x2a151b, // Very muted deep ruby hue
      transparent: true,
      opacity: 0.45,
    });
    const innerCore = new THREE.LineSegments(innerWire, innerMat);
    rootGroup.add(innerCore);

    // 2. Distributed Topological Constellation Nodes
    const NODE_COUNT = 90;
    const nodeCoords: THREE.Vector3[] = [];
    const nodeVelocities: THREE.Vector3[] = [];
    const spreadX = 220;
    const spreadY = 140;
    const spreadZ = 120;

    for (let i = 0; i < NODE_COUNT; i++) {
      const pos = new THREE.Vector3(
        (Math.random() - 0.5) * spreadX,
        (Math.random() - 0.5) * spreadY,
        (Math.random() - 0.5) * spreadZ
      );
      nodeCoords.push(pos);
      nodeVelocities.push(
        new THREE.Vector3(
          (Math.random() - 0.5) * 0.02,
          (Math.random() - 0.5) * 0.02,
          (Math.random() - 0.5) * 0.015
        )
      );
    }

    // Node particles
    const nodesGeo = new THREE.BufferGeometry();
    const nodePositions = new Float32Array(NODE_COUNT * 3);
    const nodeColors = new Float32Array(NODE_COUNT * 3);

    for (let i = 0; i < NODE_COUNT; i++) {
      nodePositions[i * 3] = nodeCoords[i].x;
      nodePositions[i * 3 + 1] = nodeCoords[i].y;
      nodePositions[i * 3 + 2] = nodeCoords[i].z;

      // Soft muted zinc with very rare faint crimson nodes (1 in 8)
      if (i % 8 === 0) {
        nodeColors[i * 3] = 0.85;     // R
        nodeColors[i * 3 + 1] = 0.12; // G
        nodeColors[i * 3 + 2] = 0.28; // B
      } else {
        nodeColors[i * 3] = 0.35;
        nodeColors[i * 3 + 1] = 0.36;
        nodeColors[i * 3 + 2] = 0.40;
      }
    }

    nodesGeo.setAttribute('position', new THREE.BufferAttribute(nodePositions, 3));
    nodesGeo.setAttribute('color', new THREE.BufferAttribute(nodeColors, 3));

    const nodesMat = new THREE.PointsMaterial({
      size: 2.2,
      vertexColors: true,
      transparent: true,
      opacity: 0.65,
    });
    const nodePoints = new THREE.Points(nodesGeo, nodesMat);
    rootGroup.add(nodePoints);

    // 3. Dynamic Connective Edges (Form lines between nodes that are close)
    const MAX_CONNECTIONS = 160;
    const linePositions = new Float32Array(MAX_CONNECTIONS * 2 * 3);
    const lineColors = new Float32Array(MAX_CONNECTIONS * 2 * 3);
    const linesGeo = new THREE.BufferGeometry();
    linesGeo.setAttribute('position', new THREE.BufferAttribute(linePositions, 3));
    linesGeo.setAttribute('color', new THREE.BufferAttribute(lineColors, 3));

    const linesMat = new THREE.LineBasicMaterial({
      vertexColors: true,
      transparent: true,
      opacity: 0.3,
      blending: THREE.NormalBlending,
    });
    const connectionLines = new THREE.LineSegments(linesGeo, linesMat);
    rootGroup.add(connectionLines);

    // Mouse & Scroll Interactivity
    let mouseX = 0, mouseY = 0;
    let targetMouseX = 0, targetMouseY = 0;

    const onMouseMove = (e: MouseEvent) => {
      targetMouseX = (e.clientX / width - 0.5) * 2;
      targetMouseY = -(e.clientY / height - 0.5) * 2;
    };
    window.addEventListener('mousemove', onMouseMove, { passive: true });

    let scrollRatio = 0;
    const onScroll = () => {
      const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight || 1;
      scrollRatio = Math.min(Math.max(scrollY / docHeight, 0), 1);
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    const onResize = () => {
      width = getWidth();
      height = getHeight();
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    };
    window.addEventListener('resize', onResize);

    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const time = clock.getElapsedTime();

      // Smooth mouse follow
      mouseX += (targetMouseX - mouseX) * 0.03;
      mouseY += (targetMouseY - mouseY) * 0.03;

      // Slow, meditative rotation
      monolith.rotation.y = time * 0.04;
      monolith.rotation.x = Math.sin(time * 0.03) * 0.15;

      innerCore.rotation.y = -time * 0.06;
      innerCore.rotation.z = Math.cos(time * 0.04) * 0.2;

      // Drift nodes gently within bounds
      const posArr = nodesGeo.attributes.position.array as Float32Array;
      for (let i = 0; i < NODE_COUNT; i++) {
        const c = nodeCoords[i];
        const v = nodeVelocities[i];
        c.add(v);

        if (Math.abs(c.x) > spreadX / 2) v.x *= -1;
        if (Math.abs(c.y) > spreadY / 2) v.y *= -1;
        if (Math.abs(c.z) > spreadZ / 2) v.z *= -1;

        posArr[i * 3] = c.x;
        posArr[i * 3 + 1] = c.y;
        posArr[i * 3 + 2] = c.z;
      }
      nodesGeo.attributes.position.needsUpdate = true;

      // Update connective lines
      const lPos = linesGeo.attributes.position.array as Float32Array;
      const lCol = linesGeo.attributes.color.array as Float32Array;
      let lineIdx = 0;
      const connectDist = 38;

      for (let i = 0; i < NODE_COUNT && lineIdx < MAX_CONNECTIONS; i++) {
        for (let j = i + 1; j < NODE_COUNT && lineIdx < MAX_CONNECTIONS; j++) {
          const dist = nodeCoords[i].distanceTo(nodeCoords[j]);
          if (dist < connectDist) {
            const alpha = 1.0 - dist / connectDist;
            const idx6 = lineIdx * 6;

            lPos[idx6] = nodeCoords[i].x;
            lPos[idx6 + 1] = nodeCoords[i].y;
            lPos[idx6 + 2] = nodeCoords[i].z;
            lPos[idx6 + 3] = nodeCoords[j].x;
            lPos[idx6 + 4] = nodeCoords[j].y;
            lPos[idx6 + 5] = nodeCoords[j].z;

            // Faint, eye-friendly connection line color
            const intensity = 0.15 * alpha;
            lCol[idx6] = intensity;
            lCol[idx6 + 1] = intensity;
            lCol[idx6 + 2] = intensity * 1.1;
            lCol[idx6 + 3] = intensity;
            lCol[idx6 + 4] = intensity;
            lCol[idx6 + 5] = intensity * 1.1;

            lineIdx++;
          }
        }
      }

      // Zero out unused connections
      for (let k = lineIdx * 6; k < MAX_CONNECTIONS * 6; k++) {
        lPos[k] = 0;
        lCol[k] = 0;
      }
      linesGeo.attributes.position.needsUpdate = true;
      linesGeo.attributes.color.needsUpdate = true;

      // Parallax view tilt
      rootGroup.rotation.y = mouseX * 0.15;
      rootGroup.rotation.x = -mouseY * 0.12;
      rootGroup.position.y = -scrollRatio * 18;

      renderer.render(scene, camera);
    }

    animate();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTopology);
  } else {
    initTopology();
  }
</script>
