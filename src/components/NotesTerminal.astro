---
// Column 2: Technical skills from the final résumé.
const skills = [
  { category: 'Languages', tools: 'TypeScript, C#, Go, Dart, JavaScript, Python, SQL, Shell' },
  { category: 'Backend', tools: 'ASP.NET Core, EF Core, Node.js, NestJS, Bun/Elysia, Go/Gin' },
  { category: 'AI systems', tools: 'Agent orchestration, RAG, MCP, LanceDB, Qdrant, OpenRouter' },
  { category: 'Data & storage', tools: 'PostgreSQL, SQL Server, Redis, Elasticsearch, Prisma, SQLite, MinIO, S3' },
  { category: 'Infrastructure', tools: 'Docker Swarm, Linux, NGINX, CI/CD, Cloudflare Workers, Asynq' },
  { category: 'Observability', tools: 'OpenTelemetry, Sentry, Serilog, Grafana Loki' },
  { category: 'Testing', tools: 'Jest, Vitest, Playwright' },
  { category: 'Web & mobile', tools: 'React, Next.js, SvelteKit, React Native, Flutter, Riverpod' },
];
---

<div class="space-y-3 font-mono" id="notes">
  <div class="flex items-center justify-between border-b border-[#141418] pb-2">
    <div class="flex items-center space-x-2">
      <span class="text-[#e11d48] font-bold">&gt;</span>
      <h2 class="text-xs md:text-sm font-bold text-zinc-100 uppercase tracking-wider">cat skills.txt</h2>
    </div>
    <span class="text-[10px] text-zinc-600">[03] TECHNICAL INDEX</span>
  </div>

  <div class="border border-[#141418] bg-[#050507] p-5 h-[calc(100%-2.2rem)] font-mono text-xs space-y-3">
    <div class="flex items-center justify-between text-zinc-600 text-[10px] pb-1 border-b border-[#141418]">
      <span>CATEGORY // TOOLCHAIN</span>
      <span>RESUME</span>
    </div>

    <dl class="space-y-3">
      {skills.map((skill) => (
        <div class="space-y-1">
          <dt class="text-[10px] text-[#e11d48] font-bold uppercase tracking-wider">{skill.category}</dt>
          <dd class="text-[11px] text-zinc-400 leading-relaxed">{skill.tools}</dd>
        </div>
      ))}
    </dl>

    <div class="pt-3 border-t border-[#141418] flex items-center justify-between text-[10px] text-zinc-600">
      <span>{skills.length} skill groups</span>
      <span>SOURCE: RESUME</span>
    </div>
  </div>
</div>
