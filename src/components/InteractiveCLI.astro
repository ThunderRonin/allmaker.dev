---
// Interactive CLI Shell for the Allmaker Portfolio
---

<section class="space-y-3 font-mono mt-8" id="cli" data-purpose="interactive-cli">
  <div class="flex items-center justify-between border-b border-[#141418] pb-2 text-xs">
    <div class="flex items-center space-x-2">
      <span class="text-[#e11d48] font-bold">&gt;</span>
      <h2 class="text-xs md:text-sm font-bold text-zinc-100 uppercase tracking-wider">sh // guest_interactive_console</h2>
    </div>
    <span class="text-[10px] text-zinc-600 font-mono">TYPE 'help' FOR COMMANDS</span>
  </div>

  <div class="border border-[#141418] bg-[#030304] p-4 md:p-6 space-y-3 text-xs min-h-[250px] flex flex-col justify-between">
    <!-- Terminal History Output -->
    <div id="cli-output" class="space-y-2 overflow-y-auto max-h-[360px] text-zinc-300 font-mono text-[11px] leading-relaxed">
      <div class="text-zinc-500">
        AllOS v2.4 (x86_64-baremetal-edge)<br />
        Session: <span class="text-zinc-400">guest@allmaker-node</span><br />
        Type <span class="text-[#e11d48] font-bold">help</span> to view available system commands.
      </div>
    </div>

    <!-- Terminal Input Form -->
    <form id="cli-form" class="flex items-center space-x-2 border-t border-[#141418] pt-3">
      <span class="text-zinc-600 font-bold select-none text-[11px]">guest@allmaker:~$</span>
      <input
        id="cli-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        class="flex-1 bg-transparent border-none text-[#d4d4d8] focus:outline-none focus:ring-0 font-mono text-xs px-1 placeholder:text-zinc-700"
        placeholder="type command (e.g. 'help', 'repos', 'allknower')..."
      />
      <button type="submit" class="px-2 py-0.5 bg-[#18181b] hover:bg-[#27272a] border border-[#27272a] text-zinc-300 text-[10px] font-bold uppercase transition-colors">
        EXEC
      </button>
    </form>
  </div>
</section>

<script>
  function initCLI() {
    const form = document.getElementById('cli-form') as HTMLFormElement;
    const input = document.getElementById('cli-input') as HTMLInputElement;
    const output = document.getElementById('cli-output') as HTMLDivElement;

    if (!form || !input || !output) return;

    const consulting = `[INDEPENDENT SOFTWARE ENGINEER]
Period: Apr 2021 – Present
Engagement: Freelance | Remote
Key Highlights:
  • Delivered technical bounties addressing production bottlenecks, protocol security, and custom automation across diverse codebases.
  • Built full-stack systems and microservices for international clients, focusing on reliability and low operational overhead.`;

    const commands: Record<string, string | (() => string)> = {
      help: `AVAILABLE COMMANDS:
  <span class="text-[#e11d48]">help</span>         - Display this command manual
  <span class="text-[#e11d48]">about</span>        - Output engineer dossier & 5+ years experience
  <span class="text-[#e11d48]">repos</span>        - List featured systems & repositories (@allmaker)
  <span class="text-[#e11d48]">kasb</span>         - Inspect Kasb Platform commerce, ledger & infrastructure work
  <span class="text-[#e11d48]">petaproc</span>     - Inspect PetaProc real-time VoIP & AI platform
  <span class="text-[#e11d48]">dorj</span>         - Inspect Dorj Wallet backend & hardware signing work
  <span class="text-[#e11d48]">bounty</span>       - Inspect independent software engineering & technical bounties
  <span class="text-[#e11d48]">allknower</span>    - Inspect AllKnower AI orchestration service
  <span class="text-[#e11d48]">allcodex</span>     - Inspect the AllCodex ecosystem & portal
  <span class="text-[#e11d48]">aryamehr</span>     - Inspect Zepp OS astronomical calendar
  <span class="text-[#e11d48]">alltracker</span>   - Inspect AllTracker desktop & mobile telemetry tracker
  <span class="text-[#e11d48]">skills</span>       - List technical proficiencies
  <span class="text-[#e11d48]">education</span>    - Output education & qualifications
  <span class="text-[#e11d48]">contact</span>      - Output communication endpoints
  <span class="text-[#e11d48]">resume</span>       - Output resume download endpoint
  <span class="text-[#e11d48]">uname -a</span>     - Query kernel & edge architecture
  <span class="text-[#e11d48]">whoami</span>       - Print current authorization status
  <span class="text-[#e11d48]">date</span>         - Print synchronized UTC timestamp
  <span class="text-[#e11d48]">clear</span>        - Flush terminal screen`,
      about: `<span class="text-zinc-200 font-bold">Amirali Daliri</span> (@theAllmaker):
Full-Stack Software Engineer | Backend &amp; AI
Location: Tehran, Iran
Experience: 5+ years across freelance and in-house roles
Profile:
  • Specializes in backend engineering and AI systems.
  • Builds .NET commerce services, Go real-time communications, and AI applications with RAG, vector search, and LLM routing.
  • Sole technical lead at Kasb, owning backend, web, mobile, and infrastructure delivery.`,
      repos: `FEATURED SYSTEMS & REPOSITORIES (@allmaker):
  • <a href="https://github.com/Kasb-Platform" target="_blank" class="text-zinc-200 underline">Kasb Platform</a>     - Financial ledger & B2B commerce (ASP.NET Core, EF Core, Docker Swarm, Linux)
  • <a href="https://github.com/PetaProc" target="_blank" class="text-zinc-200 underline">PetaProc</a>          - Real-time communications & AI (Go/Pion WebRTC, NestJS, Flutter, Riverpod)
  • <a href="https://github.com/ThunderRonin/allknower" target="_blank" class="text-zinc-200 underline">AllKnower</a>         - AI orchestration (Bun/Elysia, RAG, LanceDB, OpenRouter, MCP)
  • <a href="https://github.com/ThunderRonin/allcodex-core" target="_blank" class="text-zinc-200 underline">AllCodex Ecosystem</a> - Portal built with Next.js & SvelteKit
  • <a href="https://github.com/ThunderRonin/aryamehr-calendar" target="_blank" class="text-zinc-200 underline">AryaMehr Calendar</a>  - Amazfit GTR 4 astronomical calendar, traditional Gahs & solar prayer times
  • <a href="https://github.com/ThunderRonin/AllTracker" target="_blank" class="text-zinc-200 underline">AllTracker</a>        - Desktop & mobile habit/telemetry tracker (Flutter, Riverpod, SQLite)`,
      kasb: `[KASB PLATFORM]
Financial Ledger, B2B Commerce & Systems Infrastructure
Role: Lead Full-Stack &amp; Systems Infrastructure Engineer
Period: 2025 – Present | Tehran, Iran
Stack: ASP.NET Core + EF Core + SQL Server + PostgreSQL + Docker Swarm + Linux + Syncfusion Blink
Key Highlights:
  • Owned backend, web, mobile, and DevOps as the sole technical lead, using specialized AI agents to support implementation.
  • Resolved double-entry reconciliation discrepancies and enforced transactional invariants.
  • Migrated Windows/IIS to Linux containers with Docker Swarm, isolated overlay networks, and self-hosted CI runners.
  • Optimized constrained infrastructure using container resource limits, memory-efficient services, and caching without increasing the budget.
  • Built financial document rendering with Persian typography and RTL invoices in Linux containers using Syncfusion Blink.
  • Prepared the SQL Server-to-PostgreSQL migration through EF Core multi-provider abstractions and migration validation test suites.
Org: https://github.com/Kasb-Platform`,
      petaproc: `[PETAPROC]
Real-Time Communications & AI
Role: Full-Stack Engineer | Real-Time Systems &amp; AI
Period: Sep 2024 – Apr 2026 | Tehran | London
Stack: Go/Gin + Pion WebRTC + WebSocket + Socket.IO + NestJS + Flutter/Riverpod + Redis + LanceDB + Qdrant + Asynq + MinIO + Elasticsearch
Key Highlights:
  • Built Go voice/video services with Pion WebRTC media relays and WebSocket signaling; used Socket.IO and Redis pub/sub for horizontal scaling.
  • Implemented AI vector search with LanceDB and Qdrant.
  • Instrumented services with OpenTelemetry distributed tracing and Sentry error monitoring.
  • Integrated asynchronous media processing with Asynq, Redis job queues, and MinIO object storage.
  • Maintained NestJS and Go/Gin REST APIs; replaced PostgreSQL full-text search with Elasticsearch.
  • Delivered Flutter clients for iOS, Android, and desktop with Riverpod, call UI, threaded replies, file uploads, and widget tests.`,
      dorj: `[DORJ WALLET]
Role: Back-End Developer
Period: Apr 2024 – Aug 2024 | Tehran, Iran
Stack: NestJS + Ethers.js + Ledger SDK
Key Highlights:
  • Built cryptocurrency-platform APIs with wallet connectivity, transaction signing, and smart-contract interactions.
  • Integrated the Ledger SDK for hardware-based transaction signing.`,
      bounty: consulting,
      freelance: consulting,
      allknower: `[ALLKNOWER]
AI orchestration service for the AllCodex ecosystem.
Stack: Bun/Elysia + RAG + LanceDB + Local Embeddings + OpenRouter + MCP
Features: Retrieval-augmented generation, vector search, multi-model LLM routing, and MCP server connectivity.
Repo: https://github.com/ThunderRonin/allknower`,
      allcodex: `[ALLCODEX ECOSYSTEM]
AllCodex portal built with Next.js and SvelteKit.
Integrates AllKnower AI orchestration, RAG, OpenRouter multi-model routing, and MCP server connectivity.
Repo: https://github.com/ThunderRonin/allcodex-core`,
      aryamehr: `[ARYAMEHR-CALENDAR]
AryaMehr Persian & Zoroastrian Calendar and prayer computation engine for Amazfit GTR 4.
Platform: Zepp OS on Amazfit GTR 4; traditional Gahs and solar prayer-time computation.
Repo: https://github.com/ThunderRonin/aryamehr-calendar`,
      alltracker: `[ALLTRACKER]
Released habit and telemetry tracker for desktop and mobile.
Stack: Flutter + Riverpod + Offline-First SQLite + System Tray Integration.
Repo: https://github.com/ThunderRonin/AllTracker`,
      skills: `TOOLCHAIN & ENGINEERING PROFICIENCIES:
  • Languages:              TypeScript, C#, Go, Dart, JavaScript, Python, SQL, Shell
  • Backend:                ASP.NET Core, EF Core, Node.js, NestJS, Bun/Elysia, Go/Gin
  • AI systems:             Agent orchestration, RAG, MCP, LanceDB, Qdrant, OpenRouter
  • Data &amp; storage:         PostgreSQL, SQL Server, Redis, Elasticsearch, Prisma, SQLite, MinIO, S3
  • Infrastructure:         Docker Swarm, Linux, NGINX, CI/CD, Cloudflare Workers, Asynq
  • Observability &amp; testing: OpenTelemetry, Sentry, Serilog, Grafana Loki, Jest, Vitest, Playwright
  • Web &amp; mobile:           React, Next.js, SvelteKit, React Native, Flutter, Riverpod`,
      education: `EDUCATION:
  • Bachelor's in Computer Engineering (in progress) | 2023 – Present
    Iran University of Industries, Tehran
  • Allameh Helli High School | NODET | 2020 – 2023
    Diploma in Mathematics &amp; Physics | Tehran, Iran
    National Organization for Development of Exceptional Talents`,
      contact: `COMMUNICATION ENDPOINTS:
  • Telegram:            <a href="https://t.me/theallmaker" target="_blank" class="text-zinc-200 underline">https://t.me/theallmaker</a> (@theallmaker)
  • LinkedIn:            <a href="https://www.linkedin.com/in/amirali-daliri" target="_blank" class="text-zinc-200 underline">https://www.linkedin.com/in/amirali-daliri</a>
  • GitHub:              <a href="https://github.com/ThunderRonin" target="_blank" class="text-zinc-200 underline">https://github.com/ThunderRonin</a>
  • Email:               <a href="mailto:amirali@allmaker.dev" class="text-zinc-200 underline">amirali@allmaker.dev</a>
  • Web:                 <a href="https://allmaker.dev" target="_blank" class="text-zinc-200 underline">https://allmaker.dev</a>`,
      resume: `RESUME DOSSIER:
  • PDF Download: <a href="/?resume=1" data-resume-gate class="text-[#e11d48] underline font-bold cursor-pointer">amiralidaliri-final.pdf [VERIFY &amp; DOWNLOAD]</a> (Amirali Daliri)`,
      'uname -a': `Linux allmaker-edge-01 6.8.0-allmaker #1 SMP PREEMPT_DYNAMIC x86_64 GNU/Linux`,
      whoami: `guest (UID: 1000, GID: 1000, Roles: [public_observer, edge_client])`,
      date: () => new Date().toUTCString(),
    };

    const history: string[] = [];
    let historyIndex = -1;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const rawCmd = input.value.trim();
      if (!rawCmd) return;

      history.push(rawCmd);
      historyIndex = history.length;

      const cmd = rawCmd.toLowerCase();

      const cmdRow = document.createElement('div');
      cmdRow.innerHTML = `<span class="text-zinc-600 font-bold">guest@allmaker:~$</span> <span class="text-zinc-200">${escapeHtml(rawCmd)}</span>`;
      output.appendChild(cmdRow);

      if (cmd === 'clear') {
        output.innerHTML = '';
        input.value = '';
        return;
      }

      const res = commands[cmd];
      const resRow = document.createElement('div');
      resRow.className = 'text-zinc-400 pl-2 border-l border-[#27272a] py-1 whitespace-pre-wrap font-mono leading-relaxed text-[11px]';

      if (res) {
        resRow.innerHTML = typeof res === 'function' ? res() : res;
      } else {
        resRow.innerHTML = `<span class="text-[#e11d48]">command not found:</span> ${escapeHtml(rawCmd)}. Type <span class="text-[#e11d48]">help</span> for valid commands.`;
      }

      output.appendChild(resRow);
      input.value = '';
      output.scrollTop = output.scrollHeight;
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp') {
        if (historyIndex > 0) {
          historyIndex--;
          input.value = history[historyIndex] || '';
        }
      } else if (e.key === 'ArrowDown') {
        if (historyIndex < history.length - 1) {
          historyIndex++;
          input.value = history[historyIndex] || '';
        } else {
          historyIndex = history.length;
          input.value = '';
        }
      }
    });

    function escapeHtml(str: string) {
      return str.replace(/[&<>'"]/g, (tag) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;',
      }[tag] || tag));
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCLI);
  } else {
    initCLI();
  }
</script>
